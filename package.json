{
  "name": "openpayg-token-node",
  "version": "1.0.0",
  "description": "Node.js implementation of the EnAccess OpenPAYGO Token system, interoperable with the official implementations",
  "license": "Apache-2.0",
  "author": "Shadrack Lilan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tindNan/OPENPAYG-node.git"
  },
  "homepage": "https://github.com/tindNan/OPENPAYG-node#readme",
  "bugs": {
    "url": "https://github.com/tindNan/OPENPAYG-node/issues"
  },
  "keywords": [
    "openpaygo",
    "paygo",
    "pay-as-you-go",
    "token",
    "enaccess",
    "siphash",
    "solar",
    "metering"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "siphash": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
